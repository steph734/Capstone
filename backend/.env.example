# Copy this file to backend/.env and fill in real values.

MONGO_URI=
PORT=5000

SEMAPHORE_API_KEY=

# Base URL the frontend is reachable at, used to build links in emails.
PUBLIC_APP_URL=

# Brevo Transactional Email
BREVO_API_KEY=
BREVO_FROM_ADDRESS=
BREVO_FROM_NAME=

# Supabase Storage — private "email-attachments" bucket (in-app Email feature).
# SUPABASE_URL is the same project as the frontend's VITE_SUPABASE_URL.
# SUPABASE_SERVICE_ROLE_KEY is secret: Supabase dashboard -> Project Settings ->
# API -> service_role key. Never prefix it with VITE_ or expose it to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Security ─────────────────────────────────────────────────────────────────
# SESSION_SECRET must be IDENTICAL to the one the Vercel API uses (frontend/.env). The backend uses it to verify the
# signed login tokens; with it missing, every protected route refuses requests. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
# Websites allowed to call this API from a browser (comma separated). Default: localhost dev ports only.
ALLOWED_ORIGINS=http://localhost:5173
# Optional seed passwords (12+ chars). If unset, the seed scripts generate a random one and print it once.
SEED_OWNER_PASSWORD=
SEED_SUPERADMIN_PASSWORD=
SEED_THERAPIST_PASSWORD=
