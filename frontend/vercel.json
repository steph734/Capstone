{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        { "type": "host", "value": "capstone-git-frontend-therapypro.vercel.app" }
      ],
      "destination": "https://therapypro-app.vercel.app/:path*",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(self), geolocation=()"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    }
  ],
  "crons": [
    { "path": "/api/attendance/remind?type=time_in", "schedule": "55 23 * * *" },
    { "path": "/api/attendance/remind?type=time_out", "schedule": "55 8 * * *" }
  ]
}